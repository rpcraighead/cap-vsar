# Local credentials and machine-specific agent state
.env
.env.*
!.env.example
.agents/
.codex/
.claude/

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Runtime state and locally generated trust material
mumble/data/
services/*/data/
services/flightplanner/charts/
services/exercise/radio-public/
backups/
# The board container's own git clone of this repository, and the deploy key
# it pushes with. Both are per-host, and the key must never be committed.
services/board/repo/
services/board/secrets/
*.log
logs/fdr/

# Rebuildable output and packages
output/
*.zip
*.tar.gz
docs/manual/*.odt
docs/manual/*.docx

# Editor and operating-system files
.DS_Store
*~

# Manufacturer documentation (D-4). These are Becker / RHOTHETA / Technisonic
# / Garmin copyrighted manuals, useful to keep on disk and cited throughout
# the faceplate work, but not ours to redistribute. docs/SOURCES.md records
# the public URL each one came from - fetch your own copy from there.
docs/Becker_SARDF517_manual*.pdf
docs/RT600_*.pdf
docs/TDFM136*.pdf
docs/GMA1347_*.pdf
docs/gma.txt

# D-5. Page extracts from those same manuals and decks - the -pNN- in each name
# is the source page. Untracking the manuals (D-4) closed only half the
# question; these images are the same copyrighted pages, just cropped. They
# stay on disk and docs/SOURCES.md records the public URL each came from, so
# anyone can re-extract their own. Our own redrawn faceplates live under
# instruments/*/resources/ and docs/figures/manual/ and are deliberately NOT
# covered by this rule.
docs/figures/*.png
!docs/figures/manual/
