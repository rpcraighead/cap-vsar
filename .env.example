# Copy to .env and fill in. .env is gitignored - never commit it.
TZ=America/Los_Angeles
PUID=1000
PGID=1000

# Mumble SuperUser password (used once, to create channels and register users)
MUMBLE_SUPERUSER_PASSWORD=CHANGE_ME

# WireGuard: public endpoint remote peers dial.
# Use a DDNS hostname if the WAN address is dynamic - see infra/ROUTER.md.
WG_SERVERURL=203.0.113.10
WG_PEERDNS=192.0.2.1

# One peer per person. Renaming or reordering REGENERATES configs -
# only append to this list.
WG_PEERS=instructor,ic,aobd,mro,mp1,mo1,ms1,spare1,spare2
