# CAP V-SAR — environment template. Copy to .env and fill in real values;
# .env itself is gitignored and must never be committed.

# Shared across the stack — see docker-compose.yml
TZ=America/Los_Angeles

# Mumble voice server (services: mumble). BOTH ARE REQUIRED: compose refuses
# to start with either blank, because port 64738 is the one port forwarded to
# the internet and a blank server password is an open voice net (O2-3).
# The exercise console's bridge into the same server uses
# MUMBLE_SERVER_PASSWORD; docker-compose.yml sets its host and password itself.
# Quote a value that contains spaces, $ or #. scripts/deploy.sh reads these
# keys with grep, not by sourcing this file, so nothing here is evaluated.
MUMBLE_SUPERUSER_PASSWORD=
MUMBLE_SERVER_PASSWORD=

# Role tokens for the exercise console's access control (services/exercise/app/access.py).
# Sent as the X-CAPVSAR-Token header. A role left unset has its endpoints
# answer 503 (X-11): unset means closed, not open. The deployed stack runs with
# CAPVSAR_ENV=production, which also refuses CAPVSAR_DEV_OPEN. Participant
# (aircrew/base/ground_team) auth normally goes
# through the QR/short-code roster from the Setup wizard instead of these;
# INSTRUCTOR and PLUGIN are the two that matter most to set by hand.
CAPVSAR_TOKEN_INSTRUCTOR=
CAPVSAR_TOKEN_BASE=
CAPVSAR_TOKEN_PLUGIN=
# CAPVSAR_TOKEN_AIRCREW=
# CAPVSAR_TOKEN_GROUND_TEAM=

# ---- Runtime state location (O2-7) ----------------------------------------
# Every bind-mounted piece of state (Mumble DB and channel tree, exercise.db,
# the published CA, planner data, the board's clone) lives under this directory.
# Unset means "." - inside this checkout, the original layout, where a
# `git clean -fdx` or a re-clone deletes it. Set an absolute path OUTSIDE the
# checkout to survive that. The layout under it mirrors the repo:
#   mumble/data  services/exercise/data  services/exercise/radio-public
#   services/flightplanner/data  services/board/repo
# Setting this does NOT move existing data: stop the stack and move the
# directories yourself first. scripts/backup_exercise_db.py --restore covers
# exercise.db; back mumble/data up too (see docs/LAB_HOSTED_DEPLOYMENT_PLAN.md).
# CAPVSAR_STATE_DIR=/srv/capvsar-state

# Where the exercise console's SQLite database lives inside its container.
# Has a working default (/data/exercise.db) - only set this to override it.
# CAPVSAR_DB=/data/exercise.db

# ---- Agent coordination board (services/board) ---------------------------
# ENGINEERING surface, not a participant one. It is served on Caddy's 8443
# listener, never on the participant front door at 443.
#
# The credential every write must present. Unset means the board is read-only
# and says so - it does not fall open. Generate with: openssl rand -hex 24
CAPVSAR_BOARD_TOKEN=
# Exact browser origin(s) of the board, comma separated, no trailing slash.
# Only needed if the board is reached from an origin other than its own.
CAPVSAR_BOARD_ORIGINS=
# The board is OPT-IN (compose profile "board", O2-5). scripts/deploy.sh starts
# it only once the one-time setup in services/board/README.md is complete (a
# clone, a deploy key and known_hosts all present). For hand-run `docker
# compose` commands, uncomment:
# COMPOSE_PROFILES=board
#
# Host path of a git working clone of this repository, which the board keeps
# in step with Gitea. Do NOT point this at a live agent working tree - give it
# a clone of its own. Default: $CAPVSAR_STATE_DIR/services/board/repo.
# CAPVSAR_BOARD_REPO=./services/board/repo
# Host path of the SSH private key that clone pushes with (a Gitea deploy key
# with write access), and its known_hosts. These must be FILES that exist
# before the board starts; Docker would otherwise create directories.
# CAPVSAR_BOARD_SSH_KEY=./services/board/secrets/id_ed25519
# CAPVSAR_BOARD_KNOWN_HOSTS=./services/board/secrets/known_hosts

# ---- Sign in with Google / OpenID Connect (services/exercise/app/oidc.py) --
# Optional. With all four of the first set the login page offers "Sign in with
# Google" (or the issuer's label) and a verified email is matched to the seat
# the director assigned it in Setup. Leave them unset for an offline console:
# the badge-code login keeps working on its own (GET /api/auth/providers says
# which paths are on). Never commit real values.
# The issuer: Google directly, or an authentik application (OIDC discovery at
# <issuer>/.well-known/openid-configuration).
CAPVSAR_OIDC_ISSUER=
CAPVSAR_OIDC_CLIENT_ID=
CAPVSAR_OIDC_CLIENT_SECRET=
# The console's public origin; the redirect URI registered at the provider is
# exactly <this>/auth/oidc/callback.
CAPVSAR_OIDC_REDIRECT_BASE=
# Button label (default "Sign in with Google" for Google, else "Sign in").
# CAPVSAR_OIDC_LABEL=
# Google Workspace domain to require (the `hd` claim), e.g. cawg.cap.gov.
# CAPVSAR_OIDC_HD=
# Comma-separated emails that sign in as the Exercise Director without a seat
# assignment (trimmed, case-folded; dots and +tags are significant).
# CAPVSAR_OIDC_DIRECTOR_EMAILS=
# Session lifetime for both sign-in paths, seconds (default 86400, 5 min-30 d).
# CAPVSAR_SESSION_LIFETIME_S=86400
# Behind Caddy, rate-limit the sign-in callback by the proxied client address.
CAPVSAR_TRUST_PROXY=1
