# CAP V-SAR — environment template. Copy to .env and fill in real values;
# .env itself is gitignored and must never be committed.

# Shared across the stack — see docker-compose.yml
TZ=America/Los_Angeles

# Mumble voice server (services: mumble)
MUMBLE_SUPERUSER_PASSWORD=
MUMBLE_SERVER_PASSWORD=

# Exercise console's own bridge into that Mumble server, for the mission-radio
# console (services/exercise/app/radio.py). Host is typically the mumble
# container's service name (e.g. "mumble"); password matches
# MUMBLE_SERVER_PASSWORD above. Without CAPVSAR_MUMBLE_HOST the radio console
# runs with voice bridging disabled rather than failing to start.
CAPVSAR_MUMBLE_HOST=
CAPVSAR_MUMBLE_PASSWORD=

# Role tokens for the exercise console's access control (services/exercise/app/access.py).
# Sent as the X-CAPVSAR-Token header or ?token= query param. Any role left
# unset is deliberately left open (the console logs a warning naming every
# open role at startup) rather than locking operators out - set these before
# a real exercise. Participant (aircrew/base/ground_team) auth normally goes
# through the QR/short-code roster from the Setup wizard instead of these;
# INSTRUCTOR and PLUGIN are the two that matter most to set by hand.
CAPVSAR_TOKEN_INSTRUCTOR=
CAPVSAR_TOKEN_BASE=
CAPVSAR_TOKEN_PLUGIN=
# CAPVSAR_TOKEN_AIRCREW=
# CAPVSAR_TOKEN_GROUND_TEAM=

# Where the exercise console's SQLite database lives inside its container.
# Has a working default (/data/exercise.db) - only set this to override it.
# CAPVSAR_DB=/data/exercise.db

# ---- Agent coordination board (services/board) ---------------------------
# ENGINEERING surface, not a participant one. It is served on Caddy's 8443
# listener, never on the participant front door at 443.
#
# The credential every write must present. Unset means the board is read-only
# and says so - it does not fall open. Generate with: openssl rand -hex 24
CAPVSAR_BOARD_TOKEN=
# Exact browser origin(s) of the board, comma separated, no trailing slash.
# Only needed if the board is reached from an origin other than its own.
CAPVSAR_BOARD_ORIGINS=
# Host path of a git working clone of this repository, which the board keeps
# in step with Gitea. Do NOT point this at a live agent working tree - give it
# a clone of its own. See services/board/README.md for the one-time setup.
CAPVSAR_BOARD_REPO=./services/board/repo
# Host path of the SSH private key that clone pushes with (a Gitea deploy key
# with write access), and its known_hosts.
CAPVSAR_BOARD_SSH_KEY=./services/board/secrets/id_ed25519
CAPVSAR_BOARD_KNOWN_HOSTS=./services/board/secrets/known_hosts
